   "source": [
    "class ConvBlock(nn.Module):\n",
    "    def __init__(self, in_channels, out_channels):\n",
    "        super().__init__()\n",
    "\n",
    "        self.block = nn.Sequential(\n",
    "            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.LeakyReLU(0.1, inplace=True),\n",
    "\n",
    "            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.LeakyReLU(0.1, inplace=True)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.block(x)\n",
    "\n",
    "\n",
    "class AttentionGate(nn.Module):\n",
    "    def __init__(self, skip_channels, gate_channels, inter_channels):\n",
    "        super().__init__()\n",
    "\n",
    "        self.skip_proj = nn.Sequential(\n",
    "            nn.Conv2d(skip_channels, inter_channels, kernel_size=1),\n",
    "            nn.BatchNorm2d(inter_channels)\n",
    "        )\n",
    "\n",
    "        self.gate_proj = nn.Sequential(\n",
    "            nn.Conv2d(gate_channels, inter_channels, kernel_size=1),\n",
    "            nn.BatchNorm2d(inter_channels)\n",
    "        )\n",
    "\n",
    "        self.attn = nn.Sequential(\n",
    "            nn.LeakyReLU(0.1, inplace=True),\n",
    "            nn.Conv2d(inter_channels, 1, kernel_size=1),\n",
    "            nn.Sigmoid()\n",
    "        )\n",
    "\n",
    "    def forward(self, skip, gate):\n",
    "        attn = self.attn(self.skip_proj(skip) + self.gate_proj(gate))\n",
    "        return skip * attn\n",
    "\n",
    "\n",
    "class CustomAutoencoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        # Encoder\n",
    "        self.enc1 = ConvBlock(3, 48)        # 32x32\n",
    "        self.down1 = nn.Conv2d(48, 96, kernel_size=3, stride=2, padding=1)\n",
    "\n",
    "        self.enc2 = ConvBlock(96, 96)       # 16x16\n",
    "        self.down2 = nn.Conv2d(96, 192, kernel_size=3, stride=2, padding=1)\n",
    "\n",
    "        self.enc3 = ConvBlock(192, 192)     # 8x8\n",
    "        self.down3 = nn.Conv2d(192, 256, kernel_size=3, stride=2, padding=1)\n",
    "\n",
    "        self.bottleneck = ConvBlock(256, 256)  # 4x4\n",
    "\n",
    "        # Decoder\n",
    "        self.up3 = nn.ConvTranspose2d(256, 192, kernel_size=4, stride=2, padding=1)\n",
    "        self.att3 = AttentionGate(skip_channels=192, gate_channels=192, inter_channels=96)\n",
    "        self.dec3 = ConvBlock(192 + 192, 192)\n",
    "\n",
    "        self.up2 = nn.ConvTranspose2d(192, 96, kernel_size=4, stride=2, padding=1)\n",
    "        self.att2 = AttentionGate(skip_channels=96, gate_channels=96, inter_channels=48)\n",
    "        self.dec2 = ConvBlock(96 + 96, 96)\n",
    "\n",
    "        self.up1 = nn.ConvTranspose2d(96, 48, kernel_size=4, stride=2, padding=1)\n",
    "        self.att1 = AttentionGate(skip_channels=48, gate_channels=48, inter_channels=24)\n",
    "        self.dec1 = ConvBlock(48 + 48, 48)\n",
    "\n",
    "        self.out = nn.Conv2d(48, 3, kernel_size=3, padding=1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        e1 = self.enc1(x)\n",
    "\n",
    "        e2 = self.down1(e1)\n",
    "        e2 = self.enc2(e2)\n",
    "\n",
    "        e3 = self.down2(e2)\n",
    "        e3 = self.enc3(e3)\n",
    "\n",
    "        b = self.down3(e3)\n",
    "        b = self.bottleneck(b)\n",
    "\n",
    "        d3 = self.up3(b)\n",
    "        e3_att = self.att3(e3, d3)\n",
    "        d3 = torch.cat([d3, e3_att], dim=1)\n",
    "        d3 = self.dec3(d3)\n",
    "\n",
    "        d2 = self.up2(d3)\n",
    "        e2_att = self.att2(e2, d2)\n",
    "        d2 = torch.cat([d2, e2_att], dim=1)\n",
    "        d2 = self.dec2(d2)\n",
    "\n",
    "        d1 = self.up1(d2)\n",
    "        e1_att = self.att1(e1, d1)\n",
    "        d1 = torch.cat([d1, e1_att], dim=1)\n",
    "        d1 = self.dec1(d1)\n",
    "\n",
    "        out = torch.sigmoid(self.out(d1))\n",
    "        return out"
   ]
